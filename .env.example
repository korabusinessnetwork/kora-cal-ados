# Copie para .env.local e preencha. NUNCA commitar .env* (ver .gitignore).
# Regra do projeto: nada de chave hardcodada no código — sempre import.meta.env.VITE_*

# --- Cliente (navegador) — só chave pública, nunca service_role ---
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Servidor e testes — SEM prefixo VITE_ ---
# O prefixo VITE_ expõe a variável no bundle do navegador. A service_role dá acesso
# total ao banco ignorando RLS, então ela NUNCA pode carregar esse prefixo.
# Ver docs/11_SEGURANCA/multi-tenancy-rls.md.
#
# As três abaixo também alimentam o teste de isolamento (supabase/tests/). Sem elas,
# o teste PULA em vez de passar em falso.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
