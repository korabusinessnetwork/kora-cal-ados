{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["vitest/globals", "vite/client"],
    "verbatimModuleSyntax": true
  },
  "include": ["src", "supabase/tests", "scripts", "vitest.setup.ts", "vite.config.ts", "vitest.config.ts"]
}
